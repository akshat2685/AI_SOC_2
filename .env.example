# ==============================================================================
# ShieldAI (EDYSOR) Autonomous AI SOC 2 Platform - Environment Configuration
# ==============================================================================
# LEGEND:
#   [REQUIRED] = Backend refuses to boot if not set
#   [DEGRADES]  = Backend boots anyway; the feature that needs it is disabled
#                 with a clear warning in the logs
#   [LOCAL]     = Only needed for local docker-compose dev
# ------------------------------------------------------------------------------
# MVP deploy (Render backend + Vercel frontend): you only MUST set SECRET_KEY
# (Render's render.yaml auto-generates it). Everything else is set in the
# Render dashboard as needed. See DEPLOY.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Auth secret  [REQUIRED]
# ------------------------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_64_char_hex_string

# ------------------------------------------------------------------------------
# 2. AI Engine  [DEGRADES] - without these, triage/investigation agents stay dark
# ------------------------------------------------------------------------------
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 3. Databases  [DEGRADES]
# ------------------------------------------------------------------------------
# Postgres: set by Render automatically (render.yaml wires POSTGRES_URL from
# the managed database). Unset locally -> SQLite fallback ./soc.db
POSTGRES_URL=
DATABASE_URL=

# Neo4j (attack-chain / asset-topology graph) [DEGRADES]
# 5-minute free setup: https://neo4j.com/cloud/aura/ -> copy the bolt URI
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SOAR Automation Engine  [DEGRADES] - without these, auto-response is off
# ------------------------------------------------------------------------------
SOAR_API_KEY=
SOAR_API_ENDPOINT=
SOAR_CONNECTOR_API_KEY=

# ------------------------------------------------------------------------------
# 5. Streaming / cache  [DEGRADES]
# ------------------------------------------------------------------------------
# Kafka: unset -> event bus runs in-memory with a warning. Set to go live:
# KAFKA_BOOTSTRAP_SERVERS=your-kafka-host:9092
KAFKA_BOOTSTRAP_SERVERS=

# Redis (cache & rate limiting) [DEGRADES]
REDIS_URL=

# ------------------------------------------------------------------------------
# 6. CORS: frontend origin(s), comma-separated  [REQUIRED for the live frontend]
# ------------------------------------------------------------------------------
# Local dev default works out of the box. For the live deploy, set this to
# your Vercel URL, e.g. https://aisoc2-frontend.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 7. Frontend (Vercel env var, NOT Render)  [REQUIRED for the live frontend]
# ------------------------------------------------------------------------------
# Set NEXT_PUBLIC_API_URL in the Vercel dashboard to your Render backend URL,
# e.g. https://aisoc2-backend.onrender.com (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 8. Audit signing  [DEGRADES]
# ------------------------------------------------------------------------------
AUDIT_SECRET_KEY=

# ==============================================================================
# LOCAL docker-compose dev only [LOCAL] - the compose stack provides these
# ==============================================================================
# POSTGRES_USER=soc
# POSTGRES_PASSWORD=changeme_in_production
# POSTGRES_DB=soc
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# QDRANT_URL=http://qdrant:6333
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# VAULT_ADDR=http://vault:8200
